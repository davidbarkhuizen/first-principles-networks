#!/usr/bin/env bash

set -euo pipefail

option="${1:-}"

venv_root=".venv"
os_packages="python3-tk cargo"
rust_crate_root="rust/indrajala_ml_array"

clean () {

    rm -rf .pytest_cache
    rm -rf indrajala_ml/__pycache__
    rm -rf indrajala_ml/demos/__pycache__
    rm -rf tests/__pycache__
}

install_os_packages () {

    echo "installing os packages ..."
    sudo apt-get install -y $os_packages
    echo "... installed os packages"
}

create_venv () {

    echo "creating virtual environment @ $venv_root ..."
    python3 -m venv "$venv_root"
    echo "... created virtual environment @ $venv_root"
}

activate_venv () {

    source "$venv_root/bin/activate"
    echo "$(python --version) venv @ $(which python)"
}

deactivate_venv () {

    deactivate
}

install_and_upgrade_pip () {

    python -m pip install --upgrade pip
    echo "$(python -m pip --version)"
}

install_python_modules () {

    echo "installing python modules ..."
    python -m pip install -r requirements.txt
    echo "... installed python modules"
}

install_maturin () {

    echo "installing maturin ..."
    python -m pip install maturin
    echo "... installed maturin"
}

fetch_data () {

    echo "fetching datasets ..."
    python scripts/fetch_datasets.py
    echo "... fetched datasets"
}

build_rust () {

    echo "building $rust_crate_root ..."
    # --release, not a plain debug build: a debug build of this crate measured 65-427x slower
    # than numpy on the same forward pass a release build only measures 2-10x slower on - see
    # docs/rust-production-cutover.md's "the decisive finding this plan has to answer first" for
    # the re-measurement that caught this.
    (cd "$rust_crate_root" && maturin develop --release)
    echo "... built $rust_crate_root"
}


setup () {

    install_os_packages
    create_venv
    activate_venv
    install_and_upgrade_pip
    install_python_modules
    install_maturin
    build_rust
    fetch_data
    deactivate_venv
}

run_tests () {

    activate_venv
    # tests/ (this package's own tests) and $rust_crate_root/tests/ (the Rust crate's own
    # Python-facing parity/correctness tests, e.g. test_fused_layer_ops.py) are both real,
    # committed test suites - pytest with no path argument happens to collect both when run
    # from the repo root (no testpaths config restricts it), which is how some past PRs' own
    # test-plan counts (~1650+) included both without anyone noticing only one was ever run
    # here or in CI. Listed explicitly so both actually run every time, not by accident.
    python3 -m pytest --verbose tests/ "$rust_crate_root/tests/"
    deactivate_venv
}

demo () {

    activate_venv
    python3 -m indrajala_ml.demos.menu "$@"
    deactivate_venv
}

usage () {
    echo "usage: invoke [ clean | setup | build-rust | fetch-data | test | demo [demo-number] ]"
}

case "$option" in

    clean)
        clean
    ;;

    setup)
        setup
    ;;

    build-rust)
        activate_venv
        build_rust
        deactivate_venv
    ;;

    fetch-data)
        activate_venv
        fetch_data
        deactivate_venv
    ;;

    test)
        clean
        run_tests
    ;;

    demo)
        shift
        demo "$@"
    ;;

    *)
        usage
    ;;
esac
